# Copy to /etc/geegoo-agent/env (chmod 600, root:geegoo-agent)
# Environment variables override matching fields in config.json.

# Optional overrides (see infra/secrets.py); prefer geegoo-agent setup → config.json
# LLM_TOKEN_KEY=sk-...
# MCP_TOKEN=mcp-...
# MK_API_KEY=mk-...
# SK_API_KEY=sk-...

# User LLM settings (per-gateway model prefs) → QT_DB.user.llm_settings
# Same URI as GeeGooBot; when set, Mongo is authoritative (JSON files are fallback + auto-migrated).
# GEEGOO_BOT_MONGO_URI=mongodb://...
# GEEGOO_BOT_MONGO_DB=QT_DB
